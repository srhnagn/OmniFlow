<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Configuration Menu for To-Do -->
    <menuitem id="omniflow_todo_config_menu" name="Configuration" parent="project_todo.menu_todo_todos" sequence="100"/>
    
    <!-- Action to load default stages from menu -->
    <record id="action_menu_load_default_stages" model="ir.actions.server">
        <field name="name">Load Default Stages</field>
        <field name="model_id" ref="project.model_project_task_type"/>
        <field name="state">code</field>
        <field name="code">
action = env['project.task.type'].action_load_default_stages()
        </field>
    </record>

    <!-- Menu Item for Load Default Stages -->
    <menuitem id="omniflow_menu_load_stages" 
              name="Load Default Stages" 
              parent="omniflow_todo_config_menu" 
              action="action_menu_load_default_stages" 
              sequence="10"/>

    <!-- Hide the main Apps menu -->
    <record id="base.menu_management" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Restrict All Tasks menu to Superadmin (System Admin) -->
    <record id="project.menu_project_management_all_tasks" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <!-- HIDE Configuration -> Projects Menus -->
    <record id="project.menu_projects_config" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="project.menu_projects_config_group_stage" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- CHANGE Main Projects Actions to Open as List (Tree) by Default -->
    <record id="project.open_view_project_all" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" eval="False"/>
    </record>
    <record id="project.open_view_project_all_group_stage" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form,calendar,activity</field>
        <field name="view_id" eval="False"/>
    </record>

    <!-- Adjust sequences for open_view_project_all_group_stage views so Tree is first -->
    <record id="project.open_view_project_all_group_stage_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="5"/>
    </record>
    <record id="project.open_view_project_all_group_stage_kanban_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
    </record>
</odoo>
