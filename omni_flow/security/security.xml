<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- OmniFlow Category -->
        <record model="ir.module.category" id="module_category_omniflow">
            <field name="name">OmniFlow</field>
            <field name="description">Helps you manage your OmniFlow tasks and approvals.</field>
            <field name="sequence">20</field>
        </record>

        <!-- OmniFlow User / Worker -->
        <record id="group_omniflow_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_omniflow"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- OmniFlow Manager -->
        <record id="group_omniflow_manager" model="res.groups">
            <field name="name">Manager (Approver)</field>
            <field name="category_id" ref="module_category_omniflow"/>
            <field name="implied_ids" eval="[(4, ref('group_omniflow_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
